# Rename this file to .env and fill in your own values.
# NEVER commit or share your real .env file — your bot token is a secret credential.

TOKEN=your-bot-token-here
PREFIX=Cz!
OWNERS=123456789012345678,987654321098765432

TRACKER_SEED_GUILD_ID=0
TRACKER_SEED_CHANNEL_ID=0
TRACKER_SEED_BOT_IDS=

# Optional: set to one server ID while testing so slash commands sync there
# instantly instead of waiting up to an hour for a global sync.
SLASH_SYNC_GUILD_ID=0
